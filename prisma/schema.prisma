generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id            String   @id @default("internal")
  planLabel     String   @default("Conta interna")
  analysesLeft  Int      @default(988)
  noDeadline    Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Analysis {
  id            String   @id @default(cuid())
  banca         String
  organization  String   @default("")
  questionText  String
  correctLetter String
  userMarked    String?
  optionsJson   String
  resultJson    String
  createdAt     DateTime @default(now())
}

// Compras liberadas (Cakto). Uma linha por e-mail + plano.
model Purchase {
  id          String   @id @default(cuid())
  email       String
  plan        String   @default("lifetime") // lifetime | pass30
  status      String   @default("approved") // approved | refunded
  provider    String   @default("cakto")
  refId       String?
  amountCents Int?
  createdAt   DateTime @default(now())

  @@unique([email, plan])
  @@index([email])
}

// Funil de captação: quem autorizou receber novidades/ofertas (LGPD).
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  whatsapp  String?
  consent   Boolean  @default(false)
  source    String   @default("landing") // landing | app | gate | admin
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuração do site editável pelo painel admin (key/value sobre defaults).
model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Caixa de entrada do suporte (botão "Suporte" da landing — sem e-mail visível).
model SupportMessage {
  id        String   @id @default(cuid())
  email     String
  name      String?
  message   String
  status    String   @default("new") // new | read | replied
  createdAt DateTime @default(now())

  @@index([status])
}
