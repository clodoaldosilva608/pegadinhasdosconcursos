generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id            String   @id @default("internal")
  planLabel     String   @default("Conta interna")
  analysesLeft  Int      @default(988)
  noDeadline    Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Analysis {
  id            String   @id @default(cuid())
  banca         String
  organization  String   @default("")
  questionText  String
  correctLetter String
  userMarked    String?
  optionsJson   String
  resultJson    String
  createdAt     DateTime @default(now())
}

// Compras liberadas (Cakto). Uma linha por e-mail + plano.
model Purchase {
  id          String   @id @default(cuid())
  email       String
  plan        String   @default("lifetime") // lifetime | pass30
  status      String   @default("approved") // approved | refunded
  provider    String   @default("cakto")
  refId       String?
  amountCents Int?
  createdAt   DateTime @default(now())

  @@unique([email, plan])
  @@index([email])
}
