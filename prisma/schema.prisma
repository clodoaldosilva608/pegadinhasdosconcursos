generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: runtime usa o pooler (transaction mode, IPv4 — serverless-safe);
  // migrations/db push usam a conexão direta (DIRECT_DATABASE_URL).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Account {
  id            String   @id @default("internal")
  planLabel     String   @default("Conta interna")
  analysesLeft  Int      @default(988)
  noDeadline    Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Analysis {
  id            String   @id @default(cuid())
  banca         String
  organization  String   @default("")
  questionText  String
  correctLetter String
  userMarked    String?
  optionsJson   String
  resultJson    String
  createdAt     DateTime @default(now())
}

// Compras liberadas (Cakto). Uma linha por e-mail + plano.
model Purchase {
  id          String   @id @default(cuid())
  email       String
  plan        String   @default("lifetime") // lifetime | pass30
  status      String   @default("approved") // approved | refunded
  provider    String   @default("cakto")
  refId       String?
  amountCents Int?
  createdAt   DateTime @default(now())

  @@unique([email, plan])
  @@index([email])
}

// Funil de captação: quem autorizou receber novidades/ofertas (LGPD).
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  whatsapp  String?
  consent   Boolean  @default(false)
  source    String   @default("landing") // landing | app | gate | admin
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuração do site editável pelo painel admin (key/value sobre defaults).
model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Caixa de entrada do suporte (botão "Suporte" da landing — sem e-mail visível).
model SupportMessage {
  id        String   @id @default(cuid())
  email     String
  name      String?
  message   String
  status    String   @default("new") // new | read | replied
  createdAt DateTime @default(now())

  @@index([status])
}

// Recuperação de venda: quem preencheu o checkout da Cakto e não pagou
// (evento checkout_abandonment). Libera o envio 1-clique no painel admin.
model AbandonedCheckout {
  id          String    @id @default(cuid())
  email       String
  plan        String // pass30 | lifetime
  phone       String?
  productRef  String?
  lastEventAt DateTime  @default(now())
  recoveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([email, plan])
  @@index([email])
}

// Uso do app por aparelho (Task 18): cada aparelho que abre o /app registra
// uma linha — base da aba "Usuários do app" no painel (plano, aparelho,
// visitas, 1ª/última visita). O plano/e-mail aparece quando há acesso pago
// verificado no aparelho; sem isso, é uso gratuito do lançamento.
model AppUser {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  plan        String   @default("free") // free | pass30 | lifetime
  email       String?
  userAgent   String?
  visits      Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
}

// Conta de usuário da plataforma (/entrar): e-mail + senha (scrypt).
// Sessão stateless via cookie assinado (mesma técnica do acesso pago/admin).
// Se o e-mail tem compra aprovada (Purchase), o login emite o MESMO token de
// acesso pago — a conta restaura o acesso comprado em qualquer aparelho.
model AuthUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}
